# Terraform/OpenTofu
**/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log

# Keys & secrets — never committed; passwords live in your Key Vault
*.key
*.pem
*.p12
*.db
# OpenZiti enrollment tokens (single-use secrets) - M06 writes er-pp-01.jwt next to its compose files
*.jwt

# OS noise
.DS_Store
Thumbs.db

# Settings files - every module: copy .env.example to .env and edit your copy; .env is never committed
.env
!.env.example
