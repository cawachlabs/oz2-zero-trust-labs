{
  "uid": "meridian-overlay-health",
  "title": "Meridian Overlay Health",
  "tags": [
    "meridian",
    "openziti",
    "m10"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "1 · Raft leader",
      "description": "SLO: one leader. Each controller's agent probes its own raft health check every 30 s: the leader answers 200 (up), a follower 429 (down). The controller reporting up is the leader.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^monitor.name$/",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "raft-probes"
          },
          "query": "monitor.status:up",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "monitor.name",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "timeFrom": "2m"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "2 · Controllers answering",
      "description": "SLO: quorum intact. Controllers whose raft probe got ANY HTTP answer (200 or 429) in the last full minute. Below 2 of 3, the cluster has lost quorum.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "raft-probes"
          },
          "query": "http.response.status_code:*",
          "metrics": [
            {
              "id": "1",
              "type": "cardinality",
              "field": "monitor.name"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "1"
              }
            }
          ],
          "timeField": "@timestamp",
          "alias": "answering"
        }
      ],
      "timeFrom": "5m"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "3 · Agents reporting",
      "description": "The pipeline itself: controllers whose Elastic Agent pushed a metrics scrape in the last full minute (every agent scrapes once a minute). A drop means that agent, its host or its path to Elasticsearch is down — the Kibana rule alerts on it.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-metrics"
          },
          "query": "prometheus.metrics.ziti_ctrl_rx_msgrate:*",
          "metrics": [
            {
              "id": "1",
              "type": "cardinality",
              "field": "host.name"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "1"
              }
            }
          ],
          "timeField": "@timestamp",
          "alias": "agents"
        }
      ],
      "timeFrom": "5m"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "4 · Routers reporting",
      "description": "SLO: every router online. Routers whose metrics reached the controllers in the last full minute. Compare with the online routers in ziti edge list edge-routers.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-metrics"
          },
          "query": "prometheus.metrics.ziti_edge_connections:*",
          "metrics": [
            {
              "id": "1",
              "type": "cardinality",
              "field": "prometheus.labels.source_id"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "1"
              }
            }
          ],
          "timeField": "@timestamp",
          "alias": "routers"
        }
      ],
      "timeFrom": "5m"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "5 · Terminators / services",
      "description": "SLO: every service has somewhere to land. Latest entity counts (entityCount events — the leader writes one every minute). Fewer terminators than you expect = a hosting tunneler or router went away.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-events"
          },
          "query": "ziti.namespace:entityCount",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "ziti.counts.terminators"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp",
          "alias": "terminators"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-events"
          },
          "query": "ziti.namespace:entityCount",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "ziti.counts.services"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp",
          "alias": "services"
        }
      ],
      "timeFrom": "5m"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "6 · Fleet connected",
      "description": "SLO: endpoints online. Edge connections summed across routers (identities with a live connection), from each router's latest sample.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "hideTimeOverride": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-metrics"
          },
          "query": "prometheus.metrics.ziti_edge_connections:*",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "prometheus.metrics.ziti_edge_connections"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "prometheus.labels.source_id",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "1"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ],
      "timeFrom": "5m",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "alias": "connections",
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "7 · Link latency p99",
      "description": "SLO: data-plane latency. Each router's worst link p99, from the controllers' link.latency metrics events. Series are router IDs — match them with ziti edge list edge-routers. Samples of 8888 s (Ziti's 'not measured yet') are filtered out.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-events"
          },
          "query": "ziti.namespace:metrics AND ziti.metric:\"link.latency\" AND ziti.metrics.p99:<1000000000000",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "ziti.metrics.p99"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "ziti.source_id",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "8 · Service dials by outcome",
      "description": "SLO: no sustained dial failures. Service events from every controller, per minute, by outcome (service.dial.success, service.dial.fail, service.dial.error_*).",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-events"
          },
          "query": "ziti.namespace:service",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "ziti.count"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "ziti.event_type",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "9 · Edge connect failures",
      "description": "Security signal: failed edge connections at the routers (bad, expired or unauthorized clients), per router, as Ziti's per-second rate.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-metrics"
          },
          "query": "prometheus.metrics.ziti_edge_connect_failures:*",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "prometheus.metrics.ziti_edge_connect_failures"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "prometheus.labels.source_id",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "10 · Control-plane messages",
      "description": "Control-plane load: messages each controller receives from its routers (ctrl.rx.msgrate), per second. Series are controllers; the leader usually carries the most.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "ziti-metrics"
          },
          "query": "prometheus.metrics.ziti_ctrl_rx_msgrate:*",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "prometheus.metrics.ziti_ctrl_rx_msgrate"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "prometheus.labels.source_id",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "1",
                "trimEdges": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    }
  ]
}
