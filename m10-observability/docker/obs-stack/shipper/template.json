{
  "index_patterns": ["ziti-events*"],
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "dynamic_templates": [
        { "strings_as_keywords": { "match_mapping_type": "string", "mapping": { "type": "keyword" } } }
      ],
      "properties": {
        "timestamp": { "type": "date_nanos" },
        "count": { "type": "long" }
      }
    }
  }
}
