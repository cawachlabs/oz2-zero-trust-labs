# M10 — settings for the observability stack. Copy once and edit your copy:
#   PowerShell:  Copy-Item .env.example .env
# .env is gitignored. Nothing secret lives here except the Grafana admin password — pick your own.

# Your three controllers' public names (the same FQDNs as M03), space-separated. The shipper opens one
# event stream per controller: each controller emits the events it handles itself.
CONTROLLERS=ctrl1-<dns_prefix>.eastus.cloudapp.azure.com ctrl2-<dns_prefix>.centralus.cloudapp.azure.com ctrl3-<dns_prefix>.westeurope.cloudapp.azure.com

GRAFANA_ADMIN_PASSWORD=change-me

# Pinned image tags (current on 2026-10-01). Kibana uses ELASTIC_TAG too — the two must match exactly.
PROMETHEUS_TAG=v3.15.0
BLACKBOX_TAG=v0.27.0
GRAFANA_TAG=13.2.3
ELASTIC_TAG=9.5.3
ZITI_CLI_TAG=2.0.7
