# M06 - settings for er-pp-01, the Docker edge router that hosts the partner portal.
# `docker compose` reads this file automatically; compose.yml and compose.override.yml use the values.
# Nothing here is secret. The enrollment token is passed from your shell (see the bottom of this file).

# Router image, pinned to the course version. Leaving it unpinned pulls `latest`, which is the
# version skew you met in M04. Keep every router in the course on the same version.
ZITI_ROUTER_IMAGE=openziti/ziti-router:2.0.3

# er-pp-01 only dials out - to the controllers and to the public routers' link listeners - like the
# on-prem pair from M04. Nobody dials in, so the advertised address only has to be a name the
# router's certificate can carry.
ZITI_ROUTER_ADVERTISED_ADDRESS=er-pp-01
ZITI_ROUTER_PORT=3022

# host mode: the router itself connects to the app it hosts (no transparent interception).
ZITI_ROUTER_MODE=host

# --private: no link listener. The M04 rule for routers behind NAT or inside Docker.
ZITI_BOOTSTRAP_CONFIG_ARGS=--private

# ZITI_ENROLL_TOKEN is deliberately not in this file - a token is a single-use secret.
# Set it in your shell before the first `docker compose up -d`:
#   PowerShell:    $env:ZITI_ENROLL_TOKEN = (Get-Content .\er-pp-01.jwt -Raw).Trim()
#   bash / zsh:    export ZITI_ENROLL_TOKEN="$(cat ./er-pp-01.jwt)"
