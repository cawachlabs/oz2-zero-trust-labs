# ============================================================================
# Meridian Logistics — M06 Partner Windows VM settings
# Copy this file to terraform.tfvars:
#     cp terraform.tfvars.example terraform.tfvars
# ============================================================================

subscription_id     = "xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
resource_group_name = "rg-meridian-ziti-lab-01"

# REQUIRED — same handle as M03 and M04
dns_prefix          = "meridian-yourname"
owner               = "yourname"

# RDP access CIDR — restrict to your workstation's public IP (e.g. "203.0.113.10/32") or "0.0.0.0/0"
allowed_rdp_cidr    = "0.0.0.0/0"

admin_username      = "azureuser"
# Strong password meeting Windows complexity (>=12 chars, upper, lower, number, special)
admin_password      = "ChangeMe123!@#Secure"

vm_size             = "Standard_B2ms"
