# M08 - settings for ziti-host-pp-01, the unprivileged container that hosts the partner portal.
# `docker compose` reads this file automatically; compose.yml uses the value below.
# Nothing here is secret. The enrollment token is passed from your shell (see the bottom of this file).

# The hosting tunneler rides the C tunneler's own 1.x line (there is no ziti-edge-tunnel 2.0), so it
# does not match the 2.0.3 routers and controllers - that is expected. Pin it; `latest` moves.
ZITI_HOST_TAG=1.19.1

# ZITI_ENROLL_TOKEN is deliberately not in this file - a token is a single-use secret.
# Set it in your shell before the first `docker compose up -d`:
#   PowerShell:    $env:ZITI_ENROLL_TOKEN = (Get-Content .\ziti-host-pp-01.jwt -Raw).Trim()
#   bash / zsh:    export ZITI_ENROLL_TOKEN="$(cat ./ziti-host-pp-01.jwt)"
