# M08 - settings for er-sc-dispatch-01, the tproxy sidecar router, and dispatch, the app behind it.
# `docker compose` reads this file automatically; compose.yml and compose.override.yml use the values.
# Nothing here is secret. The enrollment token is passed from your shell (see the bottom of this file).

# Router image, pinned to the course version - the same pin as er-pp-01 and the controllers.
ZITI_ROUTER_IMAGE=openziti/ziti-router:2.0.3

# The sidecar only dials out, like er-pp-01, so the advertised address only has to be a name its
# certificate can carry. The port moves to 3023 because the official compose publishes the router
# port on the host, and er-pp-01 already holds 3022.
ZITI_ROUTER_ADVERTISED_ADDRESS=er-sc-dispatch-01
ZITI_ROUTER_PORT=3023

# tproxy mode: the router intercepts traffic in its own network namespace - which dispatch shares -
# and answers DNS for overlay names on 127.0.0.1.
ZITI_ROUTER_MODE=tproxy

# --private: no link listener. It only dials out, like er-pp-01.
ZITI_BOOTSTRAP_CONFIG_ARGS=--private

# The range the router hands intercept addresses out of. Written out at the router's default so Lab S03
# Drill 3 can move it. The router writes its config file ONCE, on first start: to apply a new range,
# set ZITI_BOOTSTRAP_CONFIG=force for one start, then put it back to true.
ZITI_ROUTER_DNS_IP_RANGE=100.64.0.1/10
ZITI_BOOTSTRAP_CONFIG=true

# The app: a curl loop. Pinned like everything else.
DISPATCH_IMAGE=curlimages/curl:8.22.0

# ZITI_ENROLL_TOKEN is deliberately not in this file - a token is a single-use secret.
# Set it in your shell before the first `docker compose up -d`:
#   PowerShell:    $env:ZITI_ENROLL_TOKEN = (Get-Content .\er-sc-dispatch-01.jwt -Raw).Trim()
#   bash / zsh:    export ZITI_ENROLL_TOKEN="$(cat ./er-sc-dispatch-01.jwt)"
