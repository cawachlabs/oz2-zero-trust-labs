# M08 (optional) - settings for the host-gateway: ziti-edge-tunnel with the Linux host's network.
# `docker compose` reads this file automatically; compose.yml uses the value below.
# LINUX DOCKER HOSTS ONLY - Docker Desktop's host networking cannot make the host a client.

# The C tunneler's own 1.x line. Pin it; `latest` moves.
ZITI_EDGE_TUNNEL_TAG=1.19.1

# ZITI_ENROLL_TOKEN is deliberately not in this file - a token is a single-use secret:
#   export ZITI_ENROLL_TOKEN="$(cat ./docker-host-01.jwt)"
